{
  "name": "ieces-news-manager",
  "version": "1.0.0",
  "description": "IECES News & Activities Manager — upload and manage school news for the website",
  "main": "src/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "electron": "electron .",
    "dist": "vite build && electron-builder",
    "dist:win": "vite build && electron-builder --win",
    "release": "vite build && electron-builder --win --publish always"
  },
  "build": {
    "appId": "ph.deped.ieces.news-manager",
    "productName": "IECES News Manager",
    "copyright": "Copyright © 2026 SDO Isabela City",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main.js",
      "src/preload.js"
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "jaybhee84",
      "repo": "ieces-news-manager"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.4",
    "electron-updater": "^6.1.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.11",
    "vite-plugin-electron": "^0.28.6",
    "wait-on": "^7.2.0"
  }
}
